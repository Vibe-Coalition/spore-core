# Shared defaults — populated into new animas at creation time.
# Keys here fill blanks only; per-anima overrides always win.
# DISCORD_TOKEN and AGENT_ID are always per-anima, not shared.
#
# Copy to defaults.env and fill in your keys:
#   cp defaults.env.example defaults.env

ANTHROPIC_API_KEY=
ANIMA_MODEL=claude-sonnet-4-6

BRAVE_API_KEY=
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
DEEPGRAM_API_KEY=
XI_API_KEY=

MANAGER_SERVICE_KEY=

ANIMA_LEARNER_MODEL=claude-haiku-4-5
ANIMA_LEARNING_MODE=always
ANIMA_CONTEXT_WINDOW=200000
ANIMA_COMPACT_THRESHOLD=80000
ANIMA_COMPACT_KEEP_TAIL=20
ANIMA_MAINTAINER_IDLE_ONLY=true

ANIMA_VOICE_ENABLED=true
ANIMA_PERSONALITY_EDITABLE=true
ANIMA_SRC_EDITABLE=true
ANIMA_WEB_AUTH_PASS=

# Ingress — leave commented unless using Traefik on a VPS with a domain.
# ANIMA_INGRESS_MODE=traefik
# ANIMA_INGRESS_DOMAIN=
# ANIMA_INGRESS_HTTPS=true
