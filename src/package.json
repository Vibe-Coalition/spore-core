{
  "name": "spore",
  "version": "0.3.0",
  "description": "Spore Core agent runtime with persistent graph memory",
  "main": "app.js",
  "type": "commonjs",
  "scripts": {
    "start": "node app.js",
    "test": "node test.js",
    "graph:seed-benchmark": "node tools/seed-benchmark-graph.js",
