    "libsodium-wrappers": "^0.7.15",
    "prism-media": "^1.3.5",
    "ws": "^8.18.0",
    "@slack/bolt": "^4.4.0",
    "node-pty": "^1.0.0",
    "ssh2": "^1.16.0",
    "playwright-core": "^1.50.0",
    "nodemailer": "^6.9.16",
    "imapflow": "^1.0.0",
    "mailparser": "^3.7.0",
    "@huggingface/transformers": "^3.5.0",
    "@teng-lin/agent-fetch": "^0.1.6"
  },
