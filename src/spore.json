{
  "agentId": "spore",
  "casualModel": "claude-haiku-4-5",
  "normalModel": "claude-sonnet-4-6",
  "plannerModel": "claude-opus-4-6",
  "subagentModel": "claude-sonnet-4-6",
  "learnerModel": "claude-haiku-4-5",
  "maxTokens": 16384,
  "contextWindow": 200000,
  "graphDbPath": "./data/graph.db",
  "maxSessionMessages": 200,
  "compactTokenThreshold": 120000,
  "sessionIdleTimeoutMinutes": 60,
  "sessionDailyResetHour": 4,
  "maxMessageLength": 2000,
  "typingInterval": 5000,
  "maxQueuePerChannel": 3,
  "messageDebounceMs": 400,
  "heartbeatIntervalMinutes": 45,
  "agentTimeoutMs": 1800000,
  "healthPort": 18790,
  "logLevel": "info",
  "guilds": {},
  "privacy": {
    "default": {
      "private": false,
      "learn": true,
      "shareToFeed": true,
      "respond": true
    },
    "platforms": {},
    "sources": {}
  },
  "channels": {
    "telegram": {
      "enabled": false,
      "dmPolicy": "pairing",
      "groupPolicy": "open",
      "allowFrom": [],
      "groupAllowFrom": [],
      "requireMention": true,
      "streaming": "partial",
      "textChunkLimit": 4000,
      "chunkMode": "length",
      "reactions": false,
      "webhookPath": "/webhooks/telegram"
    },
    "slack": {
      "enabled": false,
      "requireMention": true,
      "textChunkLimit": 3000,
      "dmPolicy": "open"
    }
  },
  "maxSubagentChildren": 8,
  "dmMaxIterations": 75,
  "subagentMaxIter": 100,
  "subagentTimeoutSeconds": 3600,
  "maintainerIdleOnly": false,
  "stallSoftMs": 8000,
  "stallHardMs": 25000,
  "allowBots": false,
  "flushMessageThreshold": 30,
  "lullMaxIterations": 4,
  "loopDetection": {
    "warn": 8,
    "critical": 15,
    "pingPong": 8,
    "ceiling": 200,
    "budgetPressure": 60
  }
}
