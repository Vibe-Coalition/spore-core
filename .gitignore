node_modules/
.env
*.db
*.db-shm
*.db-wal
data/
memory/
sessions/
*.log
.DS_Store
benchmark-report.html

# Per-agent instances (runtime data, secrets, DBs)
animas/*/
!animas/.template/
animas/.auth-config.json
animas/.anima-users.json
animas/.vault-key
animas/.vault.db
animas/.ollama-status.json
animas/.ollama-cmd
animas/.ollama-result
animas/.ingress.json
animas/cleanup-graph.sh
!animas/.gitkeep

# One-off migration scripts (already executed, not needed in repo)
scripts/migrate-*.js

# Shared skills (runtime content created by agents)
shared/skills/*
!shared/skills/.gitkeep

# Shared project graphs (runtime data — DBs + project registry)
shared/graphs/*
!shared/graphs/.gitkeep

# Manager runtime (docker-compose.yml generated by setup-manager.sh, instance-specific)
manager/.env
manager/defaults.env
manager/docker-compose.yml

# Traefik runtime (generated by setup-traefik.sh, instance-specific)
traefik/

# Backup files
*.bak
