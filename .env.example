# ═══════════════════════════════════════════════════════════════════
# Anima — per-agent environment template
# Each agent gets its own .env in animas/<agent-id>/.env
# The new-agent.sh wizard generates this automatically.
#
# Priority: env vars > anima.json > defaults (see src/config.js)
# Full reference: docs/admin-guide.md § Environment Variables
# ═══════════════════════════════════════════════════════════════════

# ── Required ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Agent identity ───────────────────────────────────────────────
AGENT_ID=anima
SPORE_DISPLAY_NAME=Anima
# SPORE_NICKNAMES=                    # comma-separated trigger words for group chats
# SPORE_AGENT_BORN_DATE=              # YYYY-MM-DD — overrides graph node created date

# ── Model tiers (casual → normal → planner) ─────────────────────
# SPORE_MODEL=claude-sonnet-4-6       # DEPRECATED — sets normalModel + plannerModel
# SPORE_CASUAL_MODEL=claude-haiku-4-5
# SPORE_NORMAL_MODEL=claude-sonnet-4-6
# SPORE_PLANNER_MODEL=claude-opus-4-6
# SPORE_SUBAGENT_MODEL=claude-sonnet-4-6
# SPORE_SUBAGENT_MAX_TOKENS=          # null = auto (opus 64K, sonnet 32K, haiku 16K)
# SPORE_LEARNER_MODEL=claude-haiku-4-5
# SPORE_IMAGE_VLM_MODEL=claude-sonnet-4-6   # used by analyze_image
# SPORE_VIDEO_VLM_MODEL=gemini/gemini-2.5-pro   # used by analyze_video
# SPORE_AUDIO_VLM_MODEL=openai/gpt-audio   # used by analyze_audio

# ── Paths (set automatically by Docker) ──────────────────────────
GRAPH_DB_PATH=/data/graph.db
SESSION_DB_PATH=/data/sessions.db
# SPORE_WORKSPACE_PATH=/workspace
# SPORE_PLUGINS_DIR=                  # defaults to <repo>/shared/plugins (must be outside workspace)
# SPORE_PLUGINS_ENABLED=false         # opt-in; plugins run as full-privilege Node code with no sandbox
# SPORE_PLUGINS_HOT_RELOAD=true       # runtime install/uninstall; set false to make plugins read-only
# SPORE_EMBEDDER=gemma-300m           # active graph embedder: gemma-300m, gemini, or unset
# SPORE_CREDENTIAL_GUARD=block        # block | warn | off — refuse writes that look like API keys
# SPORE_ENABLE_CRON=true             # start cron + restore crontabs from /workspace/.crontabs

# ── Manager integration ──────────────────────────────────────────
# SPORE_OWNER=                        # manager username who owns this agent (multi-user)

# ── Platform gateways ────────────────────────────────────────────
# Each gateway auto-enables when its token is set.
# DISCORD_TOKEN=                      # Discord bot token
# TELEGRAM_BOT_TOKEN=                 # Telegram bot token
# SLACK_BOT_TOKEN=                    # Slack bot token (xoxb-...)
# SLACK_APP_TOKEN=                    # Slack app-level token (xapp-...) — both required

# ── AI service keys ──────────────────────────────────────────────
# GEMINI_API_KEY=                     # semantic embeddings (recommended)
# BRAVE_API_KEY=                      # web search tool
# REPLICATE_API_TOKEN=                 # Image generation — FLUX, Stable Diffusion, etc.
# OPENAI_API_KEY=                     # OpenAI models (openai/*), Whisper STT / OpenAI TTS
# SPORE_OPENAI_REASONING_EFFORT=high  # optional for openai/* models: none|low|medium|high|xhigh

# ── Alternative model backends ───────────────────────────────────
# Prefix model names with openai/, openrouter/, gemini/, or local/ to route.
# OPENAI_BASE_URL=https://api.openai.com/v1  # optional override for openai/* models
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_REFERER=

# LOCAL_MODEL_BASE_URL=http://host.docker.internal:11434/v1
# LOCAL_MODEL_API_KEY=local

# ── Custom OAI-compatible providers ─────────────────────────────
# Define any number of named providers. Use the name as a model prefix.
# Pattern: SPORE_PROVIDER_<NAME>_URL, _KEY, _AUTH_HEADER
# Capabilities (vision, tools, audio, video) are auto-detected at runtime.
#
# Example: host a Together AI endpoint and a Groq endpoint:
#   SPORE_PROVIDER_TOGETHER_URL=https://api.together.xyz/v1
#   SPORE_PROVIDER_TOGETHER_KEY=your-key
#   SPORE_PROVIDER_GROQ_URL=https://api.groq.com/openai/v1
#   SPORE_PROVIDER_GROQ_KEY=your-key
#
# AUTH_HEADER controls how the key is sent:
#   bearer (default)  → Authorization: Bearer <key>
#   x-api-key         → x-api-key: <key>
#   api-key           → api-key: <key>   (Azure OpenAI)
#   <any header name> → <header>: <key>
#
# Then use as model tier values:
#   SPORE_NORMAL_MODEL=together/meta-llama/Llama-4-Maverick-17B-128E
#   SPORE_CASUAL_MODEL=groq/llama-4-scout-17b-16e
#
# Providers can also be managed via the Manager UI (Providers page).

# ── Legacy multimodal fallback ─────────────────────────────────
# Used only if dedicated VLM tiers are not configured.
# SPORE_VISION_FALLBACK_MODEL=claude-sonnet-4-6

# ── Voice pipeline (STT + TTS) ───────────────────────────────────
# Voice auto-enables when at least one STT key is set.
# DEEPGRAM_API_KEY=                   # Deepgram STT
# XI_API_KEY=                         # ElevenLabs TTS
# SPORE_VOICE_ENABLED=true
# SPORE_STT_PROVIDER=deepgram         # deepgram | openai
# SPORE_TTS_PROVIDER=elevenlabs       # elevenlabs | openai | edge (free fallback)
# SPORE_TTS_VOICE=                    # ElevenLabs voice ID
# SPORE_TTS_MODEL=                    # ElevenLabs model ID
# SPORE_TTS_SPEED=1.0
# SPORE_TTS_EDGE_VOICE=en-US-AriaNeural

# ── Web panel ────────────────────────────────────────────────────
# SPORE_WEB_PORT=18800                # 0 or unset = disabled
# SPORE_BROWSER_BACKEND=zendriver     # zendriver | playwright
# SPORE_WEB_AUTH_USER=admin
# SPORE_WEB_AUTH_PASS=                # also encrypts SSH keys at rest
# SPORE_ACORN_KEY=                    # enable Acorn authentication for this instance

# ── Traefik ingress ──────────────────────────────────────────────
# SPORE_INGRESS_MODE=traefik
# SPORE_INGRESS_DOMAIN=example.com
# SPORE_INGRESS_PATH=/animas/my-agent
# SPORE_INGRESS_HTTPS=true

# ── Manager integration (set automatically by new-agent.sh) ─────
# MANAGER_URL=http://anima-manager:18900
# MANAGER_SERVICE_KEY=                # shared key for inter-agent invoke API

# ── Permissions ──────────────────────────────────────────────────
# SPORE_SRC_EDITABLE=true             # agent can modify its own source code
# SPORE_PERSONALITY_EDITABLE=true     # agent can edit anima.json identity
# SPORE_HOST_READ_PATHS=              # comma-separated host paths (mounted read-only)

# ── Context & learning ──────────────────────────────────────────
# SPORE_CONTEXT_WINDOW=200000
# SPORE_COMPACT_THRESHOLD=80000       # trigger compaction at this token count
# SPORE_COMPACT_KEEP_TAIL=20          # messages to preserve after compaction
# SPORE_LEARNING_MODE=always          # always | flush_only | disabled
# SPORE_MAINTAINER_IDLE_ONLY=true     # skip maintenance when conversations active

# ── Proactive outreach ───────────────────────────────────────────
# SPORE_PROACTIVE_ENABLED=false
# SPORE_PROACTIVE_COOLDOWN=180        # minutes between proactive messages
# SPORE_PROACTIVE_MAX_DAY=3           # hard daily cap
# SPORE_PROACTIVE_CHANNELS=           # comma-separated channel IDs (empty = all)

# ── System-prompt section budgets ────────────────────────────────
# Override the per-section token caps applied when assembling the
# agent's system prompt. Sections that exceed their cap are silently
# truncated from the END — so blowing past it can drop instructions
# the agent needs (this is what caused plan-mode RULES to vanish).
# Defaults live in src/graph/context.js GraphContext.SECTION_BUDGETS.
# Override JSON example below; unknown keys warn-and-ignore on boot.
# Known section keys: persona, identity, voice, rules, selfknowledge,
# channel, person, relevant, anti, feed, tooling, behavior, runtime,
# reflections, derived, gaps, plugin, episodes.
# SPORE_SECTION_BUDGETS={"runtime":3000,"rules":1200}
# SPORE_TOTAL_BUDGET=40000

# ── Tuning ───────────────────────────────────────────────────────
SPORE_LOG_LEVEL=info
SPORE_HEALTH_PORT=18790
# HEALTH_BIND_ADDR=0.0.0.0           # health check bind address
# SPORE_HEARTBEAT_MINUTES=120         # periodic maintenance interval
# SPORE_DEBOUNCE_MS=800               # message debounce for batch replies
# SPORE_INTERMEDIATE_THROTTLE=30      # seconds between streaming updates
# SPORE_DISCORD_ADMINS=               # comma-separated Discord user/role IDs
