# ═══════════════════════════════════════════════════════════════════
# Anima — per-agent environment template
# Each agent gets its own .env in animas/<agent-id>/.env
# The new-agent.sh wizard generates this automatically.
#
# Priority: env vars > anima.json > defaults (see src/config.js)
# Full reference: docs/admin-guide.md § Environment Variables
# ═══════════════════════════════════════════════════════════════════

# ── Required ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Agent identity ───────────────────────────────────────────────
AGENT_ID=anima
ANIMA_DISPLAY_NAME=Anima
# ANIMA_NICKNAMES=                    # comma-separated trigger words for group chats
# ANIMA_AGENT_BORN_DATE=              # YYYY-MM-DD — overrides graph node created date

# ── Model tiers (casual → normal → planner) ─────────────────────
# ANIMA_MODEL=claude-sonnet-4-6       # DEPRECATED — sets normalModel + plannerModel
# ANIMA_CASUAL_MODEL=claude-haiku-4-5
# ANIMA_NORMAL_MODEL=claude-sonnet-4-6
# ANIMA_PLANNER_MODEL=claude-opus-4-6
# ANIMA_SUBAGENT_MODEL=claude-sonnet-4-6
# ANIMA_SUBAGENT_MAX_TOKENS=          # null = auto (opus 64K, sonnet 32K, haiku 16K)
# ANIMA_LEARNER_MODEL=claude-haiku-4-5

# ── Paths (set automatically by Docker) ──────────────────────────
GRAPH_DB_PATH=/data/graph.db
SESSION_DB_PATH=/data/sessions.db
# ANIMA_WORKSPACE_PATH=/workspace
# ANIMA_PLUGINS_DIR=                  # defaults to {workspace}/plugins
# ANIMA_ENABLE_CRON=true             # start cron + restore crontabs from /workspace/.crontabs

# ── Manager integration ──────────────────────────────────────────
# ANIMA_OWNER=                        # manager username who owns this agent (multi-user)

# ── Platform gateways ────────────────────────────────────────────
# Each gateway auto-enables when its token is set.
# DISCORD_TOKEN=                      # Discord bot token
# TELEGRAM_BOT_TOKEN=                 # Telegram bot token
# SLACK_BOT_TOKEN=                    # Slack bot token (xoxb-...)
# SLACK_APP_TOKEN=                    # Slack app-level token (xapp-...) — both required

# ── AI service keys ──────────────────────────────────────────────
# GEMINI_API_KEY=                     # semantic embeddings (recommended)
# BRAVE_API_KEY=                      # web search tool
# REPLICATE_API_TOKEN=                 # Image generation — FLUX, Stable Diffusion, etc.
# OPENAI_API_KEY=                     # OpenAI models (openai/*), Whisper STT / OpenAI TTS
# ANIMA_OPENAI_REASONING_EFFORT=high  # optional for openai/* models: none|low|medium|high|xhigh

# ── Alternative model backends ───────────────────────────────────
# Prefix model names with openai/, openrouter/, gemini/, or local/ to route.
# OPENAI_BASE_URL=https://api.openai.com/v1  # optional override for openai/* models
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_REFERER=

# LOCAL_MODEL_BASE_URL=http://host.docker.internal:11434/v1
# LOCAL_MODEL_API_KEY=local

# ── Custom OAI-compatible providers ─────────────────────────────
# Define any number of named providers. Use the name as a model prefix.
# Pattern: ANIMA_PROVIDER_<NAME>_URL, _KEY, _AUTH_HEADER
# Capabilities (vision, tools, audio, video) are auto-detected at runtime.
#
# Example: host a Together AI endpoint and a Groq endpoint:
#   ANIMA_PROVIDER_TOGETHER_URL=https://api.together.xyz/v1
#   ANIMA_PROVIDER_TOGETHER_KEY=your-key
#   ANIMA_PROVIDER_GROQ_URL=https://api.groq.com/openai/v1
#   ANIMA_PROVIDER_GROQ_KEY=your-key
#
# AUTH_HEADER controls how the key is sent:
#   bearer (default)  → Authorization: Bearer <key>
#   x-api-key         → x-api-key: <key>
#   api-key           → api-key: <key>   (Azure OpenAI)
#   <any header name> → <header>: <key>
#
# Then use as model tier values:
#   ANIMA_NORMAL_MODEL=together/meta-llama/Llama-4-Maverick-17B-128E
#   ANIMA_CASUAL_MODEL=groq/llama-4-scout-17b-16e
#
# Providers can also be managed via the Manager UI (Providers page).

# ── Vision fallback ─────────────────────────────────────────────
# When the active model lacks vision and a message contains images,
# this model is used transparently for that single API call.
# ANIMA_VISION_FALLBACK_MODEL=claude-sonnet-4-6

# ── Voice pipeline (STT + TTS) ───────────────────────────────────
# Voice auto-enables when at least one STT key is set.
# DEEPGRAM_API_KEY=                   # Deepgram STT
# XI_API_KEY=                         # ElevenLabs TTS
# ANIMA_VOICE_ENABLED=true
# ANIMA_STT_PROVIDER=deepgram         # deepgram | openai
# ANIMA_TTS_PROVIDER=elevenlabs       # elevenlabs | openai | edge (free fallback)
# ANIMA_TTS_VOICE=                    # ElevenLabs voice ID
# ANIMA_TTS_MODEL=                    # ElevenLabs model ID
# ANIMA_TTS_SPEED=1.0
# ANIMA_TTS_EDGE_VOICE=en-US-AriaNeural

# ── Web panel ────────────────────────────────────────────────────
# ANIMA_WEB_PORT=18800                # 0 or unset = disabled
# ANIMA_WEB_AUTH_USER=admin
# ANIMA_WEB_AUTH_PASS=                # also encrypts SSH keys at rest

# ── Traefik ingress ──────────────────────────────────────────────
# ANIMA_INGRESS_MODE=traefik
# ANIMA_INGRESS_DOMAIN=example.com
# ANIMA_INGRESS_PATH=/animas/my-agent
# ANIMA_INGRESS_HTTPS=true

# ── Manager integration (set automatically by new-agent.sh) ─────
# MANAGER_URL=http://anima-manager:18900
# MANAGER_SERVICE_KEY=                # shared key for inter-agent invoke API

# ── Permissions ──────────────────────────────────────────────────
# ANIMA_SRC_EDITABLE=true             # agent can modify its own source code
# ANIMA_PERSONALITY_EDITABLE=true     # agent can edit anima.json identity
# ANIMA_HOST_READ_PATHS=              # comma-separated host paths (mounted read-only)

# ── Context & learning ──────────────────────────────────────────
# ANIMA_CONTEXT_WINDOW=200000
# ANIMA_COMPACT_THRESHOLD=80000       # trigger compaction at this token count
# ANIMA_COMPACT_KEEP_TAIL=20          # messages to preserve after compaction
# ANIMA_LEARNING_MODE=always          # always | flush_only | disabled
# ANIMA_MAINTAINER_IDLE_ONLY=true     # skip maintenance when conversations active

# ── Proactive outreach ───────────────────────────────────────────
# ANIMA_PROACTIVE_ENABLED=false
# ANIMA_PROACTIVE_COOLDOWN=180        # minutes between proactive messages
# ANIMA_PROACTIVE_MAX_DAY=3           # hard daily cap
# ANIMA_PROACTIVE_CHANNELS=           # comma-separated channel IDs (empty = all)

# ── Tuning ───────────────────────────────────────────────────────
ANIMA_LOG_LEVEL=info
ANIMA_HEALTH_PORT=18790
# HEALTH_BIND_ADDR=0.0.0.0           # health check bind address
# ANIMA_HEARTBEAT_MINUTES=120         # periodic maintenance interval
# ANIMA_DEBOUNCE_MS=800               # message debounce for batch replies
# ANIMA_INTERMEDIATE_THROTTLE=30      # seconds between streaming updates
# ANIMA_DISCORD_ADMINS=               # comma-separated Discord user/role IDs
