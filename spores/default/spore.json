{
  "agentId": "my-agent",
  "displayName": "Spore",
  "nicknames": ["spore"],
  "privacy": {
    "default": { "private": false, "learn": true, "shareToFeed": true, "respond": true }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "open",
      "groupPolicy": "open",
      "requireMention": false,
      "streaming": "partial",
      "textChunkLimit": 4000,
      "chunkMode": "length"
    }
  },
  "contextWindow": 32768,
  "compactTokenThreshold": 24000,
  "compactKeepTail": 20
}
