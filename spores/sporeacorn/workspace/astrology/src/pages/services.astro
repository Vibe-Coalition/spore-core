---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<BaseLayout title="Natal Chart Readings — Sarah Halevi">
  <slot name="navbar">
    <Navbar />
  </slot>

  <div class="pt-24 md:pt-28">
    <!-- Services Hero -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 bg-sandstone">
      <div class="max-w-4xl mx-auto">
        <SectionHeading title="Natal Chart Readings" />
        <p class="font-body text-bronze/80 leading-relaxed text-center max-w-2xl mx-auto mt-6">
          Your natal chart is a one-of-a-kind celestial map — drawn from the exact moment and place you were born. It reveals the planetary placements and aspects that shape your personality, your relationships, your career, and your spiritual journey. I'd love to help you explore it.
        </p>
      </div>
    </section>

    <!-- What's Included -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 bg-limestone/30">
      <div class="max-w-4xl mx-auto">
        <SectionHeading title="What's Included in a Reading" />
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-2xl mx-auto">
          <div class="flex items-start">
            <span class="text-gold mr-3 mt-1">✦</span>
            <p class="font-body text-bronze/80">Deep dive into your Sun, Moon, and Rising signs — the core of who you are</p>
          </div>
          <div class="flex items-start">
            <span class="text-gold mr-3 mt-1">✦</span>
            <p class="font-body text-bronze/80">How the planets move through all twelve houses of your chart</p>
          </div>
          <div class="flex items-start">
            <span class="text-gold mr-3 mt-1">✦</span>
            <p class="font-body text-bronze/80">Key aspects between planets and how they shape your life patterns</p>
          </div>
          <div class="flex items-start">
            <span class="text-gold mr-3 mt-1">✦</span>
            <p class="font-body text-bronze/80">The Nodes of the Moon — your karmic story and where your soul is headed</p>
          </div>
          <div class="flex items-start">
            <span class="text-gold mr-3 mt-1">✦</span>
            <p class="font-body text-bronze/80">Your unique strengths, challenges, and where the growth lives</p>
          </div>
          <div class="flex items-start">
            <span class="text-gold mr-3 mt-1">✦</span>
            <p class="font-body text-bronze/80">Gentle, honest guidance on relationships, career, and life purpose</p>
          </div>
        </div>
      </div>
    </section>

    <!-- What You Receive -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 bg-sandstone">
      <div class="max-w-4xl mx-auto">
        <SectionHeading title="What You Receive" />
        <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-8 max-w-3xl mx-auto">
          <div class="bg-limestone/70 rounded-lg p-6 text-center border-t-2 border-gold/40">
            <div class="text-3xl mb-3">📄</div>
            <h3 class="font-heading text-lg font-semibold text-earth mb-2">Written Report</h3>
            <p class="font-body text-sm text-bronze/70">A comprehensive written interpretation of your natal chart, beautifully formatted and thoughtfully crafted for you.</p>
          </div>
          <div class="bg-limestone/70 rounded-lg p-6 text-center border-t-2 border-gold/40">
            <div class="text-3xl mb-3">🤝</div>
            <h3 class="font-heading text-lg font-semibold text-earth mb-2">1-on-1 Session</h3>
            <p class="font-body text-sm text-bronze/70">A personal session with me — in person or virtual — to explore your chart together and answer your questions.</p>
          </div>
          <div class="bg-limestone/70 rounded-lg p-6 text-center border-t-2 border-gold/40">
            <div class="text-3xl mb-3">🗺️</div>
            <h3 class="font-heading text-lg font-semibold text-earth mb-2">Your Chart Image</h3>
            <p class="font-body text-sm text-bronze/70">A high-quality image of your natal chart wheel — something you can return to again and again.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- The Process -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 bg-limestone/30">
      <div class="max-w-4xl mx-auto">
        <SectionHeading title="The Process" />
        <div class="mt-8 max-w-2xl mx-auto">
          <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8 md:gap-4">
            <!-- Step 1 -->
            <div class="flex-1 text-center">
              <div class="w-14 h-14 rounded-full bg-gold/20 border-2 border-gold flex items-center justify-center mx-auto mb-3">
                <span class="font-heading text-xl font-bold text-gold">1</span>
              </div>
              <h3 class="font-heading text-lg font-semibold text-earth">Book</h3>
              <p class="font-body text-sm text-bronze/70 mt-1">Submit your inquiry through the contact form</p>
            </div>

            <!-- Connector -->
            <div class="hidden md:block w-12 h-0.5 bg-gold/30"></div>

            <!-- Step 2 -->
            <div class="flex-1 text-center">
              <div class="w-14 h-14 rounded-full bg-gold/20 border-2 border-gold flex items-center justify-center mx-auto mb-3">
                <span class="font-heading text-xl font-bold text-gold">2</span>
              </div>
              <h3 class="font-heading text-lg font-semibold text-earth">Provide Details</h3>
              <p class="font-body text-sm text-bronze/70 mt-1">Share your birth date, time, and place</p>
            </div>

            <!-- Connector -->
            <div class="hidden md:block w-12 h-0.5 bg-gold/30"></div>

            <!-- Step 3 -->
            <div class="flex-1 text-center">
              <div class="w-14 h-14 rounded-full bg-gold/20 border-2 border-gold flex items-center justify-center mx-auto mb-3">
                <span class="font-heading text-xl font-bold text-gold">3</span>
              </div>
              <h3 class="font-heading text-lg font-semibold text-earth">Receive</h3>
              <p class="font-body text-sm text-bronze/70 mt-1">Get your personalized reading and chart</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 bg-sandstone">
      <div class="max-w-4xl mx-auto">
        <SectionHeading title="Investment" />
        <div class="mt-8 max-w-xl mx-auto bg-limestone/70 rounded-lg border-l-4 border-gold p-8 text-center">
          <p class="font-body text-bronze/80 leading-relaxed">
            I offer natal chart readings at accessible rates because I believe this wisdom should be available to anyone who seeks it. Reach out and we'll find the right fit for you.
          </p>
          <p class="font-body text-bronze/60 text-sm mt-4">
            Payment details and cancellation policy shared upon booking.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-sandstone to-limestone/40">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-heading text-3xl sm:text-4xl font-bold text-earth">Begin Your Journey</h2>
        <p class="font-body text-bronze/70 mt-4">
          Ready to discover what the stars have written for you? I'd be honored to read your chart.
        </p>
        <div class="mt-8">
          <a
            href="/contact"
            class="inline-block bg-gold hover:bg-terracotta text-earth hover:text-sandstone font-body font-semibold text-sm uppercase tracking-widest px-8 py-4 rounded transition-colors duration-300 shadow-lg hover:shadow-xl"
          >
            Book a Reading
          </a>
        </div>
      </div>
    </section>
  </div>

  <slot name="footer">
    <Footer />
  </slot>
</BaseLayout>
