---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<BaseLayout title="Sarah Halevi — Natal Chart Readings">
  <slot name="navbar">
    <Navbar />
  </slot>

  <!-- Hero -->
  <Hero />

  <!-- What I Offer -->
  <section class="py-20 px-4 sm:px-6 lg:px-8 bg-sandstone">
    <div class="max-w-6xl mx-auto">
      <SectionHeading title="What I Offer" />
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-4">
        <ServiceCard
          icon="🌟"
          title="Natal Chart Reading"
          description="[PLACEHOLDER: A comprehensive reading of your birth chart, revealing the cosmic blueprint present at the moment of your birth. Understand your strengths, challenges, and soul's purpose.]"
        />
        <ServiceCard
          icon="🌙"
          title="Lunar Guidance"
          description="[PLACEHOLDER: Explore the influence of the Moon in your chart — your emotional landscape, intuitive gifts, and inner world. Discover how lunar cycles shape your experience.]"
        />
        <ServiceCard
          icon="✨"
          title="Transit Forecast"
          description="[PLACEHOLDER: Understand how current planetary movements affect your natal chart. Gain clarity on timing, opportunities, and challenges ahead in your life journey.]"
        />
      </div>
    </div>
  </section>

  <!-- About Teaser -->
  <section class="py-20 px-4 sm:px-6 lg:px-8 bg-limestone/30">
    <div class="max-w-3xl mx-auto text-center">
      <SectionHeading title="About Sarah" />
      <p class="font-body text-bronze/80 leading-relaxed mt-6">
        [PLACEHOLDER: Sarah Halevi is a professional astrology consultant with a deep passion for natal chart interpretation. With years of study and practice, she helps individuals uncover the wisdom written in the stars at the moment of their birth.]
      </p>
      <p class="font-body text-bronze/80 leading-relaxed mt-4">
        [PLACEHOLDER: Her approach blends traditional astrological techniques with intuitive insight, creating readings that are both illuminating and deeply personal.]
      </p>
      <div class="mt-8">
        <a href="/about" class="inline-block text-gold hover:text-terracotta font-body font-medium text-sm uppercase tracking-wider transition-colors">
          Learn More →
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-sandstone to-limestone/40">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="font-heading text-3xl sm:text-4xl font-bold text-earth">Ready to Discover Your Chart?</h2>
      <p class="font-body text-bronze/70 mt-4 max-w-xl mx-auto">
        [PLACEHOLDER: Your natal chart is a unique map of the heavens at the moment you were born. Book a reading and begin your journey of self-discovery.]
      </p>
      <div class="mt-8">
        <a
          href="/contact"
          class="inline-block bg-gold hover:bg-terracotta text-earth hover:text-sandstone font-body font-semibold text-sm uppercase tracking-widest px-8 py-4 rounded transition-colors duration-300 shadow-lg hover:shadow-xl"
        >
          Book a Reading
        </a>
      </div>
    </div>
  </section>

  <slot name="footer">
    <Footer />
  </slot>
</BaseLayout>
