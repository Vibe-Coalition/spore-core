---
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Gradient background -->
  <div class="absolute inset-0 bg-gradient-to-b from-sandstone via-limestone/60 to-sandstone"></div>

  <!-- Decorative constellation SVG overlay -->
  <div class="absolute inset-0 opacity-[0.07] pointer-events-none">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <!-- Scattered stars -->
      <circle cx="10%" cy="15%" r="2" fill="#D4A843" />
      <circle cx="25%" cy="8%" r="1.5" fill="#D4A843" />
      <circle cx="45%" cy="20%" r="2.5" fill="#D4A843" />
      <circle cx="60%" cy="12%" r="1.5" fill="#D4A843" />
      <circle cx="80%" cy="18%" r="2" fill="#D4A843" />
      <circle cx="90%" cy="25%" r="1.5" fill="#D4A843" />
      <circle cx="15%" cy="40%" r="1.5" fill="#D4A843" />
      <circle cx="35%" cy="35%" r="2" fill="#D4A843" />
      <circle cx="55%" cy="42%" r="1.5" fill="#D4A843" />
      <circle cx="75%" cy="38%" r="2.5" fill="#D4A843" />
      <circle cx="92%" cy="45%" r="1.5" fill="#D4A843" />
      <circle cx="8%" cy="65%" r="2" fill="#D4A843" />
      <circle cx="30%" cy="60%" r="1.5" fill="#D4A843" />
      <circle cx="50%" cy="68%" r="2" fill="#D4A843" />
      <circle cx="70%" cy="55%" r="1.5" fill="#D4A843" />
      <circle cx="88%" cy="62%" r="2" fill="#D4A843" />
      <circle cx="20%" cy="80%" r="1.5" fill="#D4A843" />
      <circle cx="42%" cy="85%" r="2" fill="#D4A843" />
      <circle cx="65%" cy="78%" r="1.5" fill="#D4A843" />
      <circle cx="85%" cy="82%" r="2" fill="#D4A843" />

      <!-- Constellation lines -->
      <line x1="10%" y1="15%" x2="25%" y2="8%" stroke="#D4A843" stroke-width="0.5" />
      <line x1="25%" y1="8%" x2="45%" y2="20%" stroke="#D4A843" stroke-width="0.5" />
      <line x1="60%" y1="12%" x2="80%" y2="18%" stroke="#D4A843" stroke-width="0.5" />
      <line x1="80%" y1="18%" x2="90%" y2="25%" stroke="#D4A843" stroke-width="0.5" />
      <line x1="15%" y1="40%" x2="35%" y2="35%" stroke="#D4A843" stroke-width="0.5" />
      <line x1="55%" y1="42%" x2="75%" y2="38%" stroke="#D4A843" stroke-width="0.5" />
      <line x1="75%" y1="38%" x2="92%" y2="45%" stroke="#D4A843" stroke-width="0.5" />
      <line x1="8%" y1="65%" x2="30%" y2="60%" stroke="#D4A843" stroke-width="0.5" />
      <line x1="50%" y1="68%" x2="70%" y2="55%" stroke="#D4A843" stroke-width="0.5" />
      <line x1="20%" y1="80%" x2="42%" y2="85%" stroke="#D4A843" stroke-width="0.5" />
      <line x1="65%" y1="78%" x2="85%" y2="82%" stroke="#D4A843" stroke-width="0.5" />
    </svg>
  </div>

  <!-- Hero Content -->
  <div class="relative z-10 text-center px-4 sm:px-6 lg:px-8 max-w-3xl">
    <h1 class="font-heading text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold text-earth leading-tight">
      Sarah Halevi
    </h1>
    <p class="font-heading text-xl sm:text-2xl md:text-3xl text-gold mt-4 tracking-wide">
      Natal Chart Readings
    </p>
    <p class="font-body text-base sm:text-lg text-bronze/80 mt-6 max-w-xl mx-auto leading-relaxed">
      Your birth chart is a love letter from the cosmos — let me help you read it.
    </p>
    <div class="mt-10">
      <a
        href="/contact"
        class="inline-block bg-gold hover:bg-terracotta text-earth hover:text-sandstone font-body font-semibold text-sm uppercase tracking-widest px-8 py-4 rounded transition-colors duration-300 shadow-lg hover:shadow-xl"
      >
        Book a Reading
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-gold/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>
