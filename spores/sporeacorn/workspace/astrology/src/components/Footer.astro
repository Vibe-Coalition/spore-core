---
const year = new Date().getFullYear();
---

<footer class="border-t-2 border-gold/40 bg-limestone/50 mt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <!-- Brand -->
      <div class="text-center md:text-left">
        <p class="font-heading text-xl font-bold text-earth">Sarah Halevi</p>
        <p class="font-body text-sm text-bronze/70 mt-1">Astrology with Heart</p>
      </div>

      <!-- Social Icons (placeholder circles) -->
      <div class="flex items-center space-x-3">
        <a href="#" class="w-9 h-9 rounded-full bg-gold/20 hover:bg-gold/40 flex items-center justify-center text-gold font-body text-xs font-semibold transition-colors" aria-label="Instagram">Ig</a>
        <a href="#" class="w-9 h-9 rounded-full bg-gold/20 hover:bg-gold/40 flex items-center justify-center text-gold font-body text-xs font-semibold transition-colors" aria-label="Facebook">Fb</a>
        <a href="#" class="w-9 h-9 rounded-full bg-gold/20 hover:bg-gold/40 flex items-center justify-center text-gold font-body text-xs font-semibold transition-colors" aria-label="Email">Em</a>
      </div>

      <!-- Copyright -->
      <div class="text-center md:text-right">
        <p class="font-body text-xs text-bronze/60">&copy; {year} Sarah Halevi. All rights reserved.</p>
      </div>
    </div>
  </div>
</footer>
