---
interface Props {
  title: string;
  description: string;
  icon: string;
}

const { title, description, icon } = Astro.props;
---

<div class="bg-limestone/70 border-l-4 border-gold rounded-r-lg p-6 hover:-translate-y-1 hover:shadow-lg transition-all duration-300">
  <div class="text-3xl mb-3">{icon}</div>
  <h3 class="font-heading text-xl font-semibold text-earth mb-2">{title}</h3>
  <p class="font-body text-sm text-bronze/80 leading-relaxed">{description}</p>
</div>
