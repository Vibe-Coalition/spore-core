Host gb200-login-2 ccw1-login-2
    HostName gb200-login-2
    User yam
    IdentityFile /workspace/.ssh/id_ed25519
    ProxyCommand /workspace/bin/tailscale --socket /workspace/tailscale.sock nc %h %p
    ControlMaster auto
    ControlPath /tmp/ssh-%r-%h
    ControlPersist 600
    ServerAliveInterval 60
    ServerAliveCountMax 3
    UserKnownHostsFile /workspace/.ssh/known_hosts
    StrictHostKeyChecking accept-new
