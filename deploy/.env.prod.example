# ═══════════════════════════════════════════════════════════════════
# Spore Core — Production deployment environment
# Copy to .env.prod and fill in your values:
#   cp deploy/.env.prod.example deploy/.env.prod
#
# Used by deploy/docker-compose.prod.yml.
#
# This file is intentionally minimal — it covers only what has to be
# decided at container-start time (image tag, agent id, ports). API
# keys (Anthropic, OpenAI, ElevenLabs, ...), model selection, voice
# preferences, gateway tokens, etc. are entered through the first-run
# wizard at <web-url>/onboarding and persist into /data/spore.json +
# /data/.env. Setting them here as well isn't broken — the plugin
# slots in spore.json take precedence at runtime — but it splits
# config across two sources and confuses operators on second boot.
# ═══════════════════════════════════════════════════════════════════

# ── Image (override to pin a release or use a private registry) ───
#SPORE_IMAGE=ghcr.io/yumlevi/spore
#SPORE_IMAGE_TAG=latest

# ── Agent identity ────────────────────────────────────────────────
SPORE_AGENT_ID=spore
#SPORE_DISPLAY_NAME=Spore       # Or leave for the wizard / derive from agent id

# ── Ports ─────────────────────────────────────────────────────────
SPORE_WEB_PORT=18803
SPORE_HEALTH_PORT=18790

# ── Inter-Spore mesh (only when a Manager service is running) ─────
#MANAGER_URL=
#MANAGER_SERVICE_KEY=             # Generate: openssl rand -hex 24

# ─────────────────────────────────────────────────────────────────
# Everything below this line is OPTIONAL and primarily for headless
# deploys (CI / kubernetes / boots without a wizard run). The web
# wizard collects these from the operator on first launch.
# ─────────────────────────────────────────────────────────────────

# Pre-seed at least one model provider for headless boots:
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#OPENROUTER_API_KEY=
#GEMINI_API_KEY=

# Pre-seed gateway tokens for headless boots (auto-enable when set):
#DISCORD_TOKEN=
#TELEGRAM_BOT_TOKEN=
#SLACK_BOT_TOKEN=
#SLACK_APP_TOKEN=
