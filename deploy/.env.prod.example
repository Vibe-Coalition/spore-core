# ═══════════════════════════════════════════════════════════════════
# Anima — Production deployment environment
# Copy to .env.prod and fill in your values:
#   cp deploy/.env.prod.example deploy/.env.prod
#
# Used by deploy/docker-compose.prod.yml
# ═══════════════════════════════════════════════════════════════════

# ── Manager ───────────────────────────────────────────────────────
MANAGER_USER=admin
MANAGER_PASS=
MANAGER_PORT=18900
MANAGER_SERVICE_KEY=          # Generate: openssl rand -hex 24

# ── Agent (first agent) ──────────────────────────────────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=               # Recommended — enables semantic vector search
AGENT_ID=anima
ANIMA_DISPLAY_NAME=Anima
ANIMA_HEALTH_PORT=18000
ANIMA_WEB_PORT=18800
ANIMA_WEB_AUTH_PASS=          # Password for the web panel

# ── Optional API keys ────────────────────────────────────────────
# REPLICATE_API_TOKEN=         # Image generation (FLUX, SD, etc.)
# BRAVE_API_KEY=              # Brave Search
# DEEPGRAM_API_KEY=           # Deepgram STT (voice)
# XI_API_KEY=                 # ElevenLabs TTS (voice)

# ── Platform tokens (all optional) ───────────────────────────────
# DISCORD_TOKEN=
# TELEGRAM_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
