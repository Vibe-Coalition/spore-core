# ═══════════════════════════════════════════════════════════════════
# Anima Watcher — systemd unit (reference/example)
#
# The installer (install.sh) generates this file dynamically with
# correct paths for your system.  This file is kept in the repo
# as a reference only.
#
# To install manually, copy this file to /etc/systemd/system/ and
# update the paths, User, and Environment values below:
#
#   sudo cp anima-watcher.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now anima-watcher
# ═══════════════════════════════════════════════════════════════════

[Unit]
Description=Anima Watcher — auto-start, restart, and stop anima containers
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/mnt/disk/anima
ExecStart=/usr/bin/node /mnt/disk/anima/anima-watcher.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=ANIMAS_DIR=/mnt/disk/anima/animas
Environment=POLL_MS=3000

[Install]
WantedBy=multi-user.target
